<resources>
    <!-- cennge-ui is dark-first: the app ships its dark theme only. -->
    <style name="Base.Theme.Practice" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cennge_primary</item>
        <item name="colorOnPrimary">@color/cennge_primary_foreground</item>
        <item name="colorPrimaryContainer">@color/cennge_primary_bg</item>
        <item name="colorOnPrimaryContainer">@color/cennge_primary_text</item>
        <item name="colorSecondary">@color/cennge_secondary</item>
        <item name="colorSurface">@color/cennge_surface_2</item>
        <item name="colorOnSurface">@color/cennge_foreground</item>
        <item name="colorOnSurfaceVariant">@color/cennge_muted</item>
        <item name="colorSurfaceContainer">@color/cennge_surface_3</item>
        <item name="colorSurfaceContainerHigh">@color/cennge_surface_4</item>
        <item name="colorOutline">@color/cennge_border</item>
        <item name="colorControlNormal">@color/cennge_foreground</item>
        <item name="colorControlActivated">@color/cennge_primary</item>
        <item name="android:colorBackground">@color/cennge_background</item>
        <item name="android:windowBackground">@color/cennge_background</item>
        <item name="android:textColorPrimary">@color/cennge_foreground</item>
        <item name="android:textColorSecondary">@color/cennge_muted</item>
        <item name="android:textColorHint">@color/cennge_muted</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="sliderStyle">@style/Widget.Cennge.Slider</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Cennge.Spinner</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Practice" parent="Base.Theme.Practice" />

    <!-- ===================================================== text -->
    <style name="Cennge.Text" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/cennge_foreground</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Cennge.Text.Display">
        <item name="android:textSize">40sp</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>
    <style name="Cennge.Text.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Cennge.Text.Subtitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Cennge.Text.Body">
        <item name="android:textColor">@color/cennge_muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="Cennge.Text.Label">
        <item name="android:textColor">@color/cennge_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Cennge.Text.Value">
        <item name="android:textColor">@color/cennge_primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Cennge.Text.Caption">
        <item name="android:textColor">@color/cennge_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- ===================================================== buttons -->
    <!-- TextView-based so the tactile layer-list is drawn exactly as designed. -->
    <style name="Cennge.Button" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:stateListAnimator">@animator/tactile_press</item>
    </style>
    <style name="Cennge.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/cennge_primary_foreground</item>
        <item name="android:drawableTint">@color/cennge_primary_foreground</item>
    </style>
    <style name="Cennge.Button.Default">
        <item name="android:background">@drawable/btn_default</item>
        <item name="android:textColor">@color/cennge_foreground</item>
        <item name="android:drawableTint">@color/cennge_foreground</item>
    </style>
    <style name="Cennge.Button.Faded">
        <item name="android:background">@drawable/btn_faded</item>
        <item name="android:textColor">@color/cennge_foreground</item>
        <item name="android:drawableTint">@color/cennge_foreground</item>
    </style>

    <style name="Cennge.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_light</item>
        <item name="android:tint">@color/cennge_foreground</item>
        <item name="android:stateListAnimator">@animator/tactile_press</item>
    </style>
    <style name="Cennge.IconButton.Faded">
        <item name="android:background">@drawable/btn_faded</item>
    </style>

    <!-- ===================================================== slider -->
    <!-- cennge-ui Slider: rounded track on surface-4, primary range, white thumb with a primary ring -->
    <style name="Widget.Cennge.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">6dp</item>
        <item name="trackCornerSize">3dp</item>
        <item name="trackInsideCornerSize">3dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackColorActive">@color/cennge_primary</item>
        <item name="trackColorInactive">@color/cennge_surface_4</item>
        <item name="thumbWidth">20dp</item>
        <item name="thumbHeight">20dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="thumbColor">@color/white</item>
        <item name="thumbStrokeColor">@color/cennge_primary</item>
        <item name="thumbStrokeWidth">2dp</item>
        <item name="thumbElevation">2dp</item>
        <item name="haloColor">@color/cennge_primary_highlight</item>
        <item name="haloRadius">18dp</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
    </style>

    <style name="Widget.Cennge.Spinner" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/cennge_primary</item>
        <item name="trackColor">@color/cennge_surface_4</item>
        <item name="trackThickness">3dp</item>
        <item name="indicatorSize">36dp</item>
    </style>
</resources>
