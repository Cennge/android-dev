<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cennge_canvas"
    android:orientation="vertical"
    tools:context=".EditorActivity">

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cennge_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/Cennge.IconButton"
            android:contentDescription="Назад"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Cennge.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/info"
                style="@style/Cennge.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                tools:text="1600 × 1067 · 3 зміни" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/undo"
            style="@style/Cennge.IconButton"
            android:contentDescription="Скасувати"
            android:src="@drawable/ic_undo"
            android:tint="@color/icon_enabled" />

        <ImageButton
            android:id="@+id/redo"
            style="@style/Cennge.IconButton"
            android:contentDescription="Повторити"
            android:src="@drawable/ic_redo"
            android:tint="@color/icon_enabled" />

        <TextView
            android:id="@+id/save"
            style="@style/Cennge.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="6dp"
            android:elevation="6dp"
            android:minHeight="40dp"
            android:outlineAmbientShadowColor="@color/cennge_primary"
            android:outlineSpotShadowColor="@color/cennge_primary"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/editor_save"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- photo -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:paddingHorizontal="20dp"
            android:paddingTop="68dp"
            android:paddingBottom="64dp"
            android:scaleType="fitCenter" />

        <com.example.android_proj.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/histogramCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass"
            android:padding="8dp"
            android:visibility="invisible">

            <com.example.android_proj.HistogramView
                android:id="@+id/histogram"
                android:layout_width="96dp"
                android:layout_height="36dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/compare"
            style="@style/Cennge.Text"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:drawableStart="@drawable/ic_compare"
            android:drawablePadding="6dp"
            android:drawableTint="@color/cennge_foreground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:text="@string/editor_hold"
            android:textFontWeight="600"
            android:textSize="12sp"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="Поділитися"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            android:visibility="invisible"
            app:tint="@color/cennge_foreground" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/loadingText"
                style="@style/Cennge.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/editor_loading" />
        </LinearLayout>

        <TextView
            android:id="@+id/toast"
            style="@style/Cennge.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:background="@drawable/bg_glass_pill"
            android:drawablePadding="8dp"
            android:drawableTint="@color/cennge_success_text"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:textFontWeight="600"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- tool sheet -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="146dp">

            <!-- filters -->
            <LinearLayout
                android:id="@+id/panelFilters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/filters"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="12dp" />

                <include
                    android:id="@+id/filterSlider"
                    layout="@layout/view_slider_row" />
            </LinearLayout>

            <!-- adjust -->
            <LinearLayout
                android:id="@+id/panelAdjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/adjustChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/adjustSlider"
                    layout="@layout/view_slider_row" />
            </LinearLayout>

            <!-- crop -->
            <LinearLayout
                android:id="@+id/panelCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/aspectChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_crop"
                        app:tint="@color/cennge_muted" />

                    <TextView
                        android:id="@+id/cropInfo"
                        style="@style/Cennge.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/crop_hint" />

                    <TextView
                        android:id="@+id/cropReset"
                        style="@style/Cennge.Button.Faded"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:drawableStart="@drawable/ic_reset"
                        android:minHeight="40dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/crop_reset"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- rotate -->
            <LinearLayout
                android:id="@+id/panelRotate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/rotateLeft"
                        style="@style/Cennge.Button.Default"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_rotate_left"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/rotate_left"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/rotateRight"
                        style="@style/Cennge.Button.Default"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_rotate_right"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/rotate_right"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/flipH"
                        style="@style/Cennge.IconButton"
                        android:layout_width="52dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/btn_default"
                        android:contentDescription="@string/flip_h"
                        android:src="@drawable/ic_flip" />

                    <ImageButton
                        android:id="@+id/flipV"
                        style="@style/Cennge.IconButton"
                        android:layout_width="52dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/btn_default"
                        android:contentDescription="@string/flip_v"
                        android:src="@drawable/ic_flip_vertical" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/straightenSlider"
                    layout="@layout/view_slider_row" />
            </LinearLayout>

            <!-- effects -->
            <LinearLayout
                android:id="@+id/panelEffects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/effectChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/effectSlider"
                    layout="@layout/view_slider_row" />
            </LinearLayout>
        </FrameLayout>

        <!-- tabs -->
        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tabs"
            android:orientation="horizontal"
            android:padding="4dp" />
    </LinearLayout>
</LinearLayout>
