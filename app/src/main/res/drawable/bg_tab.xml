<?xml version="1.0" encoding="utf-8"?>
<!-- Active tab: bg-surface-4 + inset-shadow-tactile, rounded-small -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_surface_4" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_edge_dark" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_surface_4" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_edge_light" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_surface_4" />
                    <corners android:radius="@dimen/radius_small" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
