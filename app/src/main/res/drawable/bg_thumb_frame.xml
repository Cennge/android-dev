<?xml version="1.0" encoding="utf-8"?>
<!-- Filter thumbnail frame: primary ring when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/cennge_primary" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
</selector>
