<?xml version="1.0" encoding="utf-8"?>
<!-- Input: bg-surface-2, 2dp border, primary ring when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_surface_2" />
            <stroke android:width="2dp" android:color="@color/cennge_primary" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_surface_2" />
            <stroke android:width="2dp" android:color="@color/cennge_border" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
</selector>
