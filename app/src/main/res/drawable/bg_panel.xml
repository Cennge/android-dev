<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tool sheet: surface-2 with a hairline top border and 24dp top corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_border" />
            <corners android:topLeftRadius="@dimen/radius_xl" android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_surface_2" />
            <corners android:topLeftRadius="@dimen/radius_xl" android:topRightRadius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>
