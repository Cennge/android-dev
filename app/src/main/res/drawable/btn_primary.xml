<?xml version="1.0" encoding="utf-8"?>
<!-- cennge-ui solid button: fill + inset-shadow-tactile (1px light top edge, 2px dark bottom lip). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_primary" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_edge_dark" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_primary" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_edge_light" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cennge_primary" />
                    <corners android:radius="@dimen/radius_medium" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
