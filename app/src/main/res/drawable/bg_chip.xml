<?xml version="1.0" encoding="utf-8"?>
<!-- Chip: flat default (default-bg), flat primary when selected (primary-bg + primary border) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_primary_bg" />
            <stroke android:width="1dp" android:color="@color/cennge_primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cennge_default_bg" />
            <stroke android:width="1dp" android:color="@android:color/transparent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
